<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Andrey Gubskiy</Authors>
    <Copyright>Copyright © Andrey Gubskiy 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata" Condition="'$(IsPackable)' != 'false'">
    <Product>X.Web.Lockout</Product>
    <Description>User account lockout functionality built on top of ASP.NET Core Identity.</Description>
    <PackageId>X.Web.Lockout</PackageId>
    <PackageTags>aspnetcore;identity;lockout;security;authentication</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/a-gubskiy/X.Web.Lockout</PackageProjectUrl>
    <RepositoryUrl>https://github.com/a-gubskiy/X.Web.Lockout</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
